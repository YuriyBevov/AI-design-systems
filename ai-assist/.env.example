# Target environment template. Values are placeholders; do not commit real secrets.
NODE_ENV=development
APP_BASE_URL=http://localhost:3000

DATABASE_URL=postgresql://ai_assist:change-me-local-only@localhost:55432/ai_assist
REDIS_URL=redis://localhost:6379

S3_ENDPOINT=http://localhost:9000
S3_REGION=local
S3_BUCKET=ai-assist-dev
S3_ACCESS_KEY_ID=change-me
S3_SECRET_ACCESS_KEY=change-me

# Generate independent high-entropy values. Document actual encoding/length at scaffold.
SESSION_SECRET=replace-with-at-least-32-random-characters
ADMIN_SESSION_TTL_HOURS=12
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
PROMPT_PREVIEW_RATE_LIMIT_MAX=12
PROMPT_PREVIEW_RATE_LIMIT_WINDOW_SECONDS=60
WIDGET_SESSION_TTL_HOURS=72
WIDGET_SESSION_RATE_LIMIT_MAX=30
WIDGET_SESSION_RATE_LIMIT_WINDOW_SECONDS=60
WIDGET_CHAT_RATE_LIMIT_MAX=20
WIDGET_CHAT_RATE_LIMIT_WINDOW_SECONDS=60
CREDENTIAL_ENCRYPTION_KEY_VERSION=1
CREDENTIAL_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
# JSON object: {"previousVersion":"base64-encoded-32-byte-key"}. Empty for a new install.
CREDENTIAL_ENCRYPTION_PREVIOUS_KEYS={}

# AITUNNEL tenant keys are NOT stored in environment; admins save them encrypted via UI/API.
AITUNNEL_BASE_URL=https://api.aitunnel.ru/v1
AITUNNEL_PUBLIC_CATALOG_URL=https://api.aitunnel.ru/public/aitunnel/models
PROVIDER_REQUEST_TIMEOUT_MS=8000
PROVIDER_RESPONSE_MAX_BYTES=1048576

LOG_LEVEL=debug
OTEL_EXPORTER_OTLP_ENDPOINT=

# Development seed only. Production seed refuses to run.
AI_ASSIST_DEV_OWNER_PASSWORD=replace-local-development-password
