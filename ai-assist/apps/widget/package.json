{
  "name": "@ai-assist/widget",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.widget.config.ts",
    "preview:host": "vite --config vite.preview.config.ts",
    "build": "vite build --config vite.widget.config.ts && vite build --config vite.loader.config.ts",
    "lint": "eslint src test *.ts",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai-assist/contracts": "workspace:*",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "vite": "^8.2.2",
    "vue-tsc": "^3.3.11"
  }
}
