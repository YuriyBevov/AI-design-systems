---
import logoUrl from "../images/logo-rbuh-geometric-stacked.svg?url";
import LinkList from "./LinkList.astro";
import SocialList from "./SocialList.astro";
import { contactLinks, copyright, legalLinks, socialLinks } from "../content/site/index.js";
import { services } from "../content/services/index.js";
---

<footer class="footer">
  <div class="container">
    <div class="footer__top">
      <a class="logo logo--footer" href="/" aria-label="РБУ «Хаджох» — на главную">
        <img class="logo__image" src={logoUrl} alt="РБУ «Хаджох»" width="220" height="60" loading="lazy" />
      </a>

      <div class="footer__column">
        <ul class="link-list">
          <li class="link-list__item"><a class="link-list__link" href="/services/">Услуги</a></li>
          <li class="link-list__item"><a class="link-list__link" href="/price/">Прайс-лист</a></li>
          <li class="link-list__item"><a class="link-list__link" href="/about/">О&nbsp;компании</a></li>
          <li class="link-list__item"><a class="link-list__link" href="/delivery-payment/">Доставка и&nbsp;оплата</a></li>
        </ul>
      </div>

      <div class="footer__column">
        <ul class="link-list">
          {services.map((service) => (
            <li class="link-list__item">
              <a class="link-list__link" href={`/services/${service.slug}/`}>{service.title}</a>
            </li>
          ))}
        </ul>
      </div>

      <div class="footer__column">
        <LinkList items={contactLinks} />
        <SocialList items={socialLinks} />
      </div>
    </div>

    <div class="footer__bottom">
      <span class="footer__copyright">{copyright}</span>
      <div class="footer__legal">
        {legalLinks.map((link) => (
          <a class="footer__legal-link" href={link.href}>{link.label}</a>
        ))}
      </div>
    </div>
  </div>
</footer>
