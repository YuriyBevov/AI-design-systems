{
  "version": "2.14",
  "children": [
    {
      "id": "nav-bar",
      "type": "frame",
      "name": "Навигация",
      "x": 0, "y": 0,
      "width": 1280, "height": 72,
      "layout": "horizontal",
      "alignItems": "center",
      "justifyContent": "space_between",
      "padding": [0, 24],
      "children": [
        {
          "id": "nav-logo",
          "type": "text",
          "name": "Логотип: Littleweb",
          "content": "Littleweb",
          "fontFamily": "Golos Text",
          "fontSize": 20,
          "fontWeight": 700,
          "fill": "#141413",
          "textGrowth": "auto"
        },
        {
          "id": "nav-menu",
          "type": "frame",
          "name": "Меню",
          "layout": "horizontal",
          "gap": 8,
          "alignItems": "center",
          "children": [
            { "id": "nav-link-1", "type": "text", "content": "Каталог", "fontFamily": "Golos Text", "fontSize": 12, "fontWeight": 500, "fill": "#b0aea5", "textGrowth": "auto" },
            { "id": "nav-link-2", "type": "text", "content": "О компании", "fontFamily": "Golos Text", "fontSize": 12, "fontWeight": 500, "fill": "#b0aea5", "textGrowth": "auto" },
            { "id": "nav-link-3", "type": "text", "content": "Контакты", "fontFamily": "Golos Text", "fontSize": 12, "fontWeight": 500, "fill": "#b0aea5", "textGrowth": "auto" },
            {
              "id": "nav-btn",
              "type": "frame",
              "name": "Кнопка: Заявка",
              "width": 140, "height": 36,
              "fill": "#faf9f5",
              "cornerRadius": [0, 0, 8, 8],
              "layout": "horizontal",
              "justifyContent": "center",
              "alignItems": "center",
              "children": [
                { "id": "nav-btn-text", "type": "text", "content": "Оставить заявку", "fontFamily": "Golos Text", "fontSize": 12, "fontWeight": 600, "fill": "#141413", "textGrowth": "auto" }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "hero-section",
      "type": "frame",
      "name": "Hero секция",
      "x": 0, "y": 100,
      "width": 1280,
      "layout": "horizontal",
      "gap": 76,
      "padding": [80, 24],
      "children": [
        {
          "id": "hero-left",
          "type": "frame",
          "name": "Левая колонка",
          "width": 500,
          "layout": "vertical",
          "gap": 24,
          "children": [
            {
              "id": "hero-title",
              "type": "text",
              "content": "Клейкая лента\nс логотипом от\nпроизводителя",
              "fontFamily": "Golos Text",
              "fontSize": 61,
              "fontWeight": 700,
              "lineHeight": 1.1,
              "letterSpacing": -0.12,
              "fill": "#141413",
              "textGrowth": "auto"
            }
          ]
        },
        {
          "id": "hero-right",
          "type": "frame",
          "name": "Правая колонка",
          "width": 500,
          "layout": "vertical",
          "gap": 16,
          "children": [
            {
              "id": "hero-desc",
              "type": "text",
              "content": "Собственное производство с 2003 года. Бесплатно разработаем макет, изготовим клише и предоставим образцы для тестирования.",
              "fontFamily": "PT Serif",
              "fontSize": 20,
              "lineHeight": 1.4,
              "fill": "#141413",
              "textGrowth": "fixed-width",
              "width": 500
            },
            {
              "id": "hero-btn-clay",
              "type": "frame",
              "name": "Кнопка CTA",
              "width": 220, "height": 46,
              "fill": "#d97757",
              "cornerRadius": [0, 0, 8, 8],
              "layout": "horizontal",
              "justifyContent": "center",
              "alignItems": "center",
              "children": [
                { "id": "hero-btn-clay-text", "type": "text", "content": "Рассчитать стоимость →", "fontFamily": "Golos Text", "fontSize": 16, "fontWeight": 600, "fill": "#141413", "textGrowth": "auto" }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "categories-section",
      "type": "frame",
      "name": "Секция категорий",
      "x": 24, "y": 480,
      "width": 1232,
      "layout": "horizontal",
      "gap": 24,
      "children": [
        {
          "id": "cat-card-1",
          "type": "frame",
          "name": "Карточка: Стреппинг-ленты",
          "width": 380, "height": 280,
          "fill": "#faf9f5",
          "cornerRadius": 24,
          "layout": "vertical",
          "padding": [24, 24],
          "gap": 8,
          "children": [
            { "id": "cat1-label", "type": "text", "content": "КАТЕГОРИЯ", "fontFamily": "Golos Text", "fontSize": 12, "fontWeight": 600, "fill": "#b0aea5", "textGrowth": "auto" },
            { "id": "cat1-title", "type": "text", "content": "Стреппинг-ленты", "fontFamily": "Golos Text", "fontSize": 24, "fontWeight": 600, "fill": "#141413", "textGrowth": "auto" },
            { "id": "cat1-desc", "type": "text", "content": "Полипропиленовая лента 5–19 мм для ручной и машинной упаковки. От 56 руб./ролик.", "fontFamily": "PT Serif", "fontSize": 20, "lineHeight": 1.4, "fill": "#141413", "textGrowth": "fixed-width", "width": 330 },
            { "id": "cat1-link", "type": "text", "content": "В каталог →", "fontFamily": "Golos Text", "fontSize": 14, "fontWeight": 600, "fill": "#d97757", "textGrowth": "auto" }
          ]
        },
        {
          "id": "cat-card-2",
          "type": "frame",
          "name": "Карточка: Клейкая лента",
          "width": 380, "height": 280,
          "fill": "#faf9f5",
          "cornerRadius": 24,
          "layout": "vertical",
          "padding": [24, 24],
          "gap": 8,
          "children": [
            { "id": "cat2-label", "type": "text", "content": "КАТЕГОРИЯ", "fontFamily": "Golos Text", "fontSize": 12, "fontWeight": 600, "fill": "#b0aea5", "textGrowth": "auto" },
            { "id": "cat2-title", "type": "text", "content": "Клейкая лента", "fontFamily": "Golos Text", "fontSize": 24, "fontWeight": 600, "fill": "#141413", "textGrowth": "auto" },
            { "id": "cat2-desc", "type": "text", "content": "Нова Ролл 203–208. С логотипом в 1–3 цвета. Специальные надписи. От 45 мкм.", "fontFamily": "PT Serif", "fontSize": 20, "lineHeight": 1.4, "fill": "#141413", "textGrowth": "fixed-width", "width": 330 },
            { "id": "cat2-link", "type": "text", "content": "В каталог →", "fontFamily": "Golos Text", "fontSize": 14, "fontWeight": 600, "fill": "#d97757", "textGrowth": "auto" }
          ]
        },
        {
          "id": "cat-card-3",
          "type": "frame",
          "name": "Карточка: ПЭТ-лента",
          "width": 380, "height": 280,
          "fill": "#f5e3c7",
          "cornerRadius": 24,
          "layout": "vertical",
          "padding": [24, 24],
          "gap": 8,
          "children": [
            { "id": "cat3-label", "type": "text", "content": "НОВИНКА", "fontFamily": "Golos Text", "fontSize": 12, "fontWeight": 600, "fill": "#b0aea5", "textGrowth": "auto" },
            { "id": "cat3-title", "type": "text", "content": "ПЭТ-лента", "fontFamily": "Golos Text", "fontSize": 24, "fontWeight": 600, "fill": "#141413", "textGrowth": "auto" },
            { "id": "cat3-desc", "type": "text", "content": "Полиэстеровая стрепп-лента. По прочности близка к стальной. Безопасна, пластична.", "fontFamily": "PT Serif", "fontSize": 20, "lineHeight": 1.4, "fill": "#141413", "textGrowth": "fixed-width", "width": 330 },
            { "id": "cat3-link", "type": "text", "content": "Подробнее →", "fontFamily": "Golos Text", "fontSize": 14, "fontWeight": 600, "fill": "#d97757", "textGrowth": "auto" }
          ]
        }
      ]
    },
    {
      "id": "about-section",
      "type": "frame",
      "name": "О компании",
      "x": 24, "y": 800,
      "width": 1232, "height": 200,
      "fill": "#faf9f5",
      "cornerRadius": 24,
      "layout": "vertical",
      "padding": [48, 48],
      "gap": 8,
      "children": [
        { "id": "about-label", "type": "text", "content": "О КОМПАНИИ", "fontFamily": "Golos Text", "fontSize": 12, "fontWeight": 600, "fill": "#b0aea5", "textGrowth": "auto" },
        { "id": "about-title", "type": "text", "content": "Производство упаковочных материалов с 2003 года", "fontFamily": "PT Serif", "fontSize": 36, "fontWeight": 400, "fill": "#141413", "textGrowth": "auto" },
        { "id": "about-text", "type": "text", "content": "Основное направление деятельности — производство адгезивных (клейких) лент промышленного, бытового и офисного назначения.", "fontFamily": "PT Serif", "fontSize": 20, "lineHeight": 1.4, "fill": "#141413", "textGrowth": "fixed-width", "width": 700 }
      ]
    },
    {
      "id": "footer",
      "type": "frame",
      "name": "Футер",
      "x": 0, "y": 1040,
      "width": 1280, "height": 60,
      "fill": "#141413",
      "layout": "horizontal",
      "alignItems": "center",
      "padding": [0, 24],
      "children": [
        { "id": "footer-text", "type": "text", "content": "© Littleweb — производство упаковочных материалов", "fontFamily": "Golos Text", "fontSize": 12, "fontWeight": 400, "fill": "#faf9f5", "textGrowth": "auto" }
      ]
    }
  ]
}