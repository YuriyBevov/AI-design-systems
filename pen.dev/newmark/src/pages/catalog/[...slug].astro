---
import CatalogSectionPage from "../../components/CatalogSectionPage.astro";
import ProductDetailPage from "../../components/ProductDetailPage.astro";
import {
  catalogSections,
  getCatalogSectionBreadcrumbs,
  getProductBreadcrumbs,
  products,
} from "../../content/catalog/index.js";

export const prerender = true;

export function getStaticPaths() {
  const sectionPaths = catalogSections.map((section) => ({
    params: {
      slug: section.path,
    },
    props: {
      pageType: "section",
      breadcrumbs: getCatalogSectionBreadcrumbs(section),
      section,
    },
  }));

  const productPaths = products
    .filter((product) => !product.hidden)
    .map((product) => ({
    params: {
      slug: product.href.replace(/^\/catalog\/|\/$/g, ""),
    },
    props: {
      pageType: "product",
      breadcrumbs: getProductBreadcrumbs(product),
      product,
    },
  }));

  return [...sectionPaths, ...productPaths];
}

const {
  breadcrumbs,
  pageType,
  product,
  section,
} = Astro.props;
---

{pageType === "product" ? (
  <ProductDetailPage breadcrumbs={breadcrumbs} product={product} />
) : (
  <CatalogSectionPage breadcrumbs={breadcrumbs} section={section} />
)}
