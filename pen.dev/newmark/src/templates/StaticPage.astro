---
import ContentSlider from "../components/ContentSlider.astro";

const { page } = Astro.props;
const breadcrumbs = page.breadcrumbs ?? [];
const sliderData = page.sliders ?? {};
const compiledContent = page.compiledContent ? await page.compiledContent() : "";
const imageModules = import.meta.glob("../images/webp/*", { eager: true });

const getImageSrc = (fileName) => {
  const imageModule = Object.entries(imageModules).find(([path]) => (
    path.endsWith(`/${fileName}`)
  ))?.[1];

  if (!imageModule) {
    throw new Error(`Content image "${fileName}" was not found in src/images/webp/`);
  }

  return imageModule?.default?.src ?? imageModule?.default;
};

const getSliderImages = (sliderId) => {
  return (sliderData[sliderId] ?? []).map((image) => ({
    ...image,
    src: getImageSrc(image.src),
  }));
};

const contentParts = [];
const sliderPattern = /<p>\s*\{\{\s*slider:\s*([a-z0-9-]+)\s*\}\}\s*<\/p>/gi;
let lastIndex = 0;
let match;

while ((match = sliderPattern.exec(compiledContent)) !== null) {
  if (match.index > lastIndex) {
    contentParts.push({
      type: "html",
      html: compiledContent.slice(lastIndex, match.index),
    });
  }

  contentParts.push({
    type: "slider",
    images: getSliderImages(match[1]),
  });

  lastIndex = sliderPattern.lastIndex;
}

if (lastIndex < compiledContent.length) {
  contentParts.push({
    type: "html",
    html: compiledContent.slice(lastIndex),
  });
}
---

{breadcrumbs.length > 0 && (
  <div class="breadcrumbs" aria-label="Хлебные крошки">
    <div class="container">
      <ol class="breadcrumbs__list">
        {breadcrumbs.map((item, index) => (
          <li class="breadcrumbs__item">
            {item.href && index !== breadcrumbs.length - 1 ? (
              <a class="breadcrumbs__link" href={item.href}>{item.label}</a>
            ) : (
              <span class="breadcrumbs__current">{item.label}</span>
            )}
          </li>
        ))}
      </ol>
    </div>
  </div>
)}

<section class="section">
  <div class="container">
    <div class="content">
      {contentParts.map((part) => (
        part.type === "slider" ? (
          <ContentSlider images={part.images} />
        ) : (
          <Fragment set:html={part.html} />
        )
      ))}
    </div>
  </div>
</section>
