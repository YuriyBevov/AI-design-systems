---
import benefitImage1 from "../images/webp/benefits-image-1.webp";
import benefitImage2 from "../images/webp/benefits-image-2.webp";
import benefitImage3 from "../images/webp/benefits-image-3.webp";
import benefitImage4 from "../images/webp/benefits-image-4.webp";
import benefitImage5 from "../images/webp/benefits-image-5.webp";
import heroImage from "../images/webp/hero-img.webp";
import productImage1 from "../images/webp/product-image-1.webp";
import productImage2 from "../images/webp/product-image-2.webp";
import productImage3 from "../images/webp/product-image-3.webp";
import productImage4 from "../images/webp/product-image-4.webp";
import productImage5 from "../images/webp/product-image-5.webp";
import productImage6 from "../images/webp/product-image-6.webp";
import productImage7 from "../images/webp/product-image-7.webp";
import productImage8 from "../images/webp/product-image-8.webp";
import productImage9 from "../images/webp/product-image-9.webp";
import productImage10 from "../images/webp/product-image-10.webp";
---

<section class="hero">
  <div class="container">
    <div class="hero__content">
      <h1 class="hero__title">Клейкая лента и&nbsp;аксессуары <span>для&nbsp;упаковки вашего бизнеса</span></h1>
      <p class="hero__description">Подберём ленту под&nbsp;коробки, паллеты, маркировку и&nbsp;ежедневную упаковку. В&nbsp;каталоге&nbsp;—&nbsp;брендированный скотч, стрейч-плёнка, малярные и&nbsp;специальные ленты, диспенсеры и&nbsp;сопутствующие товары.</p>
      <div class="button-row">
        <button class="button button--primary" type="button">Оставить заявку</button>
        <a class="button button--secondary" href="/catalog/">Перейти в&nbsp;каталог
          <svg class="button__icon button__icon--arrow" width="36" height="19"  aria-hidden="true">
            <use href="/sprite.svg?v=2#long-arrow"></use>
          </svg>
        </a>
      </div>
    </div>

    <div class="hero__image-wrapper">
      <img class="hero__image" src={heroImage.src} alt="Рулоны клейкой ленты" width="640" height="620" />
    </div>
  </div>
</section>

<section class="creeper-line creeper-line--catalog" aria-label="Разделы каталога">
  <div class="creeper-line__track">
    <ul class="creeper-line__list">
      <li class="creeper-line__item">Клейкая лента</li>
      <li class="creeper-line__item">Стрейч-пленка</li>
      <li class="creeper-line__item">Малярная лента</li>
      <li class="creeper-line__item">Изоляционная лента</li>
      <li class="creeper-line__item">Клейкая лента с&nbsp;логотипом</li>
      <li class="creeper-line__item">Упаковочная лента</li>
      <li class="creeper-line__item">ТПЛ</li>
      <li class="creeper-line__item">Спец. ленты</li>
      <li class="creeper-line__item">Сигнальные ленты</li>
      <li class="creeper-line__item">Термостойкая малярная лента</li>
      <li class="creeper-line__item">Ленты с&nbsp;нанесением</li>
      <li class="creeper-line__item">Аксессуары</li>
    </ul>
  </div>
</section>

<section class="section section--dark">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">Почему сотрудничать с&nbsp;нами выгодно</h2>
    </div>
    <div class="grid-layout">
      <article class="benefit-card">
        <div class="benefit-card__image-wrapper">
          <img class="benefit-card__image" src={benefitImage1.src} alt="Собственное производство" width="400" height="300" />
        </div>
        <div class="benefit-card__body">
          <span class="benefit-card__title">Собственное производство</span>
          <p class="card-description">Собственное производство! Заключая контракт с&nbsp;нами, вы получаете прямой контракт с&nbsp;производителем</p>
        </div>
      </article>

      <article class="benefit-card">
        <div class="benefit-card__image-wrapper">
          <img class="benefit-card__image" src={benefitImage2.src} alt="Прямые поставки" width="400" height="300" />
        </div>
        <div class="benefit-card__body">
          <span class="benefit-card__title">Прямые поставки</span>
          <p class="card-description">Мы осуществляем прямые поставки транспортными компаниями в&nbsp;любой город России.</p>
        </div>
      </article>

      <article class="benefit-card">
        <div class="benefit-card__image-wrapper">
          <img class="benefit-card__image" src={benefitImage3.src} alt="Заявленные параметры" width="400" height="300" />
        </div>
        <div class="benefit-card__body">
          <span class="benefit-card__title">Заявленные параметры</span>
          <p class="card-description">Вы получаете заявленные параметры упаковочных лент, а&nbsp;также&nbsp;соответствие длин намоток</p>
        </div>
      </article>

      <article class="benefit-card">
        <div class="benefit-card__image-wrapper">
          <img class="benefit-card__image" src={benefitImage4.src} alt="Гарантия возврата" width="400" height="300" />
        </div>
        <div class="benefit-card__body">
          <span class="benefit-card__title">Гарантия возврата</span>
          <p class="card-description">Мы гарантируем возврат денег в&nbsp;случае если «вдруг» вы сможете обнаружить какую-либо недостачу</p>
        </div>
      </article>

      <article class="benefit-card">
        <div class="benefit-card__image-wrapper">
          <img class="benefit-card__image" src={benefitImage5.src} alt="Ниже цены" width="400" height="300" />
        </div>
        <div class="benefit-card__body">
          <span class="benefit-card__title">Ниже цены</span>
          <p class="card-description">Наши цены ниже относительно цен компаний-перепродавцов, присутствующих на&nbsp;рынке</p>
        </div>
      </article>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">Что мы предлагаем</h2>
      <p class="section-description">Три направления каталога закрывают полный цикл упаковки: брендирование, ежедневную упаковку и&nbsp;специализированные задачи производства или&nbsp;склада.</p>
    </div>

    <div class="catalog-group">
      <ul class="catalog-group__features">
        <li class="catalog-group__features-item">Разработка дизайна для&nbsp;брендированных лент бесплатно в&nbsp;день обращения</li>
        <li class="catalog-group__features-item">Бесплатно изготовим клише с&nbsp;вашим дизайном</li>
      </ul>

      <div class="catalog-group__header">
        <span class="catalog-group__title">Клейкая лента с&nbsp;логотипом</span>
        <span class="catalog-group__offer">Сэкономите время на&nbsp;запуске брендированной упаковки: подготовим дизайн, клише и&nbsp;подберём тип печати под&nbsp;тираж.</span>
      </div>

      <div class="grid-layout">
        <article class="product-card">
          <div class="product-card__image-wrapper">
            <img class="product-card__image" src={productImage1.src} alt="Поверхностная печать" width="400" height="300" />
          </div>
          <div class="product-card__body">
            <div class="product-card__content">
              <span class="product-card__title">Поверхностная печать</span>
              <ul class="feature-list">
                <li class="feature-list__item">Быстрые сроки производства</li>
                <li class="feature-list__item">Возможность сделать небольшую пробную партию</li>
              </ul>
              <span class="clarification">*Минимальная партия&nbsp;—&nbsp;3&nbsp;коробки, срок&nbsp;производства&nbsp;—&nbsp;14&nbsp;дней</span>
            </div>
            <button class="button button--primary" type="button">Уточнить у&nbsp;менеджера</button>
          </div>
        </article>

        <article class="product-card">
          <div class="product-card__image-wrapper">
            <img class="product-card__image" src={productImage2.src} alt="Межслойная печать" width="400" height="300" />
          </div>
          <div class="product-card__body">
            <div class="product-card__content">
              <span class="product-card__title">Межслойная печать</span>
              <ul class="feature-list">
                <li class="feature-list__item">Логотип не&nbsp;стирается между&nbsp;плёнкой и&nbsp;клеем</li>
                <li class="feature-list__item">При&nbsp;отклеивании логотип остаётся на&nbsp;коробке</li>
              </ul>
              <span class="clarification">*Минимальная партия&nbsp;—&nbsp;30&nbsp;коробок, срок&nbsp;производства&nbsp;—&nbsp;30&nbsp;дней</span>
            </div>
            <button class="button button--primary" type="button">Уточнить у&nbsp;менеджера</button>
          </div>
        </article>
      </div>

      <a class="button button--secondary" href="/catalog/">Перейти в&nbsp;раздел каталога

        <svg class="button__icon button__icon--arrow" width="72" height="19" viewBox="0 0 72 19" aria-hidden="true">

          <use href="/sprite.svg?v=2#long-arrow"></use>

        </svg>

      </a>
    </div>

    <div class="catalog-group">
      <div class="catalog-group__header">
        <span class="catalog-group__title">Упаковочная лента</span>
        <span class="catalog-group__offer">Подберём решения, которые не&nbsp;порвутся при&nbsp;упаковке тяжёлого груза и&nbsp;помогут быстро закрывать ежедневные задачи склада.</span>
      </div>

      <div class="grid-layout">
        <article class="product-card">
          <div class="product-card__image-wrapper">
            <img class="product-card__image" src={productImage3.src} alt="Стрейч пленка" width="400" height="300" />
          </div>
          <div class="product-card__body">
            <div class="product-card__content">
              <span class="product-card__title">Стрейч пленка</span>
              <p class="card-description">Плотно фиксирует товар на&nbsp;паллетах и&nbsp;защищает груз при&nbsp;хранении и&nbsp;перевозке.</p>
            </div>
            <a class="button button--primary" href="/catalog/">Подробнее
              <svg class="button__icon button__icon--arrow" width="72" height="19" viewBox="0 0 72 19" aria-hidden="true">
                <use href="/sprite.svg?v=2#long-arrow"></use>
              </svg>
            </a>
          </div>
        </article>

        <article class="product-card">
          <div class="product-card__image-wrapper">
            <img class="product-card__image" src={productImage4.src} alt="Малярная лента" width="400" height="300" />
          </div>
          <div class="product-card__body">
            <div class="product-card__content">
              <span class="product-card__title">Малярная лента</span>
              <p class="card-description">Защитит поверхности при&nbsp;работах и&nbsp;легко снимается без&nbsp;повреждений.</p>
            </div>
            <a class="button button--primary" href="/catalog/">Подробнее
              <svg class="button__icon button__icon--arrow" width="72" height="19" viewBox="0 0 72 19" aria-hidden="true">
                <use href="/sprite.svg?v=2#long-arrow"></use>
              </svg>
            </a>
          </div>
        </article>

        <article class="product-card">
          <div class="product-card__image-wrapper">
            <img class="product-card__image" src={productImage5.src} alt="Спец. ленты" width="400" height="300" />
          </div>
          <div class="product-card__body">
            <div class="product-card__content">
              <span class="product-card__title">Спец. ленты</span>
              <p class="card-description">Подберём ленту под&nbsp;нестандартные условия склада, производства и&nbsp;упаковки.</p>
            </div>
            <a class="button button--primary" href="/catalog/">Подробнее
              <svg class="button__icon button__icon--arrow" width="72" height="19" viewBox="0 0 72 19" aria-hidden="true">
                <use href="/sprite.svg?v=2#long-arrow"></use>
              </svg>
            </a>
          </div>
        </article>
      </div>

      <a class="button button--secondary" href="/catalog/">Перейти в&nbsp;раздел каталога

        <svg class="button__icon button__icon--arrow" width="72" height="19" viewBox="0 0 72 19" aria-hidden="true">

          <use href="/sprite.svg?v=2#long-arrow"></use>

        </svg>

      </a>
    </div>

    <div class="catalog-group">
      <div class="catalog-group__header">
        <span class="catalog-group__title">Узкоспециализированные ленты</span>
        <span class="catalog-group__offer">Подберём материал под&nbsp;температуру, монтаж, маркировку и&nbsp;безопасность&nbsp;—&nbsp;чтобы лента работала в&nbsp;конкретных условиях применения.</span>
      </div>

      <div class="grid-layout">
        <article class="product-card">
          <div class="product-card__image-wrapper">
            <img class="product-card__image" src={productImage6.src} alt="Термостойкая малярная лента(термокрепп)." width="400" height="300" />
          </div>
          <div class="product-card__body">
            <div class="product-card__content">
              <span class="product-card__title">Термостойкая малярная лента(термокрепп).</span>
              <p class="card-description">Выдерживает температурные режимы и&nbsp;помогает аккуратно защитить поверхности на&nbsp;производстве.</p>
            </div>
            <a class="button button--primary" href="/catalog/">Подробнее
              <svg class="button__icon button__icon--arrow" width="72" height="19" viewBox="0 0 72 19" aria-hidden="true">
                <use href="/sprite.svg?v=2#long-arrow"></use>
              </svg>
            </a>
          </div>
        </article>

        <article class="product-card">
          <div class="product-card__image-wrapper">
            <img class="product-card__image" src={productImage7.src} alt="ТПЛ" width="400" height="300" />
          </div>
          <div class="product-card__body">
            <div class="product-card__content">
              <span class="product-card__title">ТПЛ</span>
              <p class="card-description">Прочная тканевая полиэтиленовая лента для&nbsp;ремонта, фиксации и&nbsp;упаковки.</p>
            </div>
            <a class="button button--primary" href="/catalog/">Подробнее
              <svg class="button__icon button__icon--arrow" width="72" height="19" viewBox="0 0 72 19" aria-hidden="true">
                <use href="/sprite.svg?v=2#long-arrow"></use>
              </svg>
            </a>
          </div>
        </article>

        <article class="product-card">
          <div class="product-card__image-wrapper">
            <img class="product-card__image" src={productImage8.src} alt="Изоляционная лента" width="400" height="300" />
          </div>
          <div class="product-card__body">
            <div class="product-card__content">
              <span class="product-card__title">Изоляционная лента</span>
              <p class="card-description">Помогает безопасно изолировать соединения и&nbsp;маркировать рабочие зоны.</p>
            </div>
            <a class="button button--primary" href="/catalog/">Подробнее
              <svg class="button__icon button__icon--arrow" width="72" height="19" viewBox="0 0 72 19" aria-hidden="true">
                <use href="/sprite.svg?v=2#long-arrow"></use>
              </svg>
            </a>
          </div>
        </article>

        <article class="product-card">
          <div class="product-card__image-wrapper">
            <img class="product-card__image" src={productImage9.src} alt="Ленты с нанесением «осторожно хрупкое», «акция», «подарок»." width="400" height="300" />
          </div>
          <div class="product-card__body">
            <div class="product-card__content">
              <span class="product-card__title">Ленты с&nbsp;нанесением «осторожно хрупкое», «акция», «подарок».</span>
              <p class="card-description">Ускоряют маркировку отправлений и&nbsp;делают упаковку понятнее для&nbsp;склада и&nbsp;клиента.</p>
            </div>
            <a class="button button--primary" href="/catalog/">Смотреть в&nbsp;каталоге
              <svg class="button__icon button__icon--arrow" width="72" height="19" viewBox="0 0 72 19" aria-hidden="true">
                <use href="/sprite.svg?v=2#long-arrow"></use>
              </svg>
            </a>
          </div>
        </article>

        <article class="product-card">
          <div class="product-card__image-wrapper">
            <img class="product-card__image" src={productImage10.src} alt="Сигнальные ленты" width="400" height="300" />
          </div>
          <div class="product-card__body">
            <div class="product-card__content">
              <span class="product-card__title">Сигнальные ленты</span>
              <p class="card-description">Помогают быстро ограждать зоны, выделять опасные участки и&nbsp;организовывать пространство.</p>
            </div>
            <a class="button button--primary" href="/catalog/">Смотреть в&nbsp;каталоге
              <svg class="button__icon button__icon--arrow" width="72" height="19" viewBox="0 0 72 19" aria-hidden="true">
                <use href="/sprite.svg?v=2#long-arrow"></use>
              </svg>
            </a>
          </div>
        </article>
      </div>

      <a class="button button--secondary" href="/catalog/">Перейти в&nbsp;раздел каталога

        <svg class="button__icon button__icon--arrow" width="72" height="19" viewBox="0 0 72 19" aria-hidden="true">

          <use href="/sprite.svg?v=2#long-arrow"></use>

        </svg>

      </a>
    </div>
  </div>
</section>

<section class="section section--dark advantages">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">Преимущества, которые работают</h2>
      <p class="section-description">Для&nbsp;нас важна каждая деталь в&nbsp;производстве лент, а&nbsp;для&nbsp;вас&nbsp;—&nbsp;точность и&nbsp;уверенность в&nbsp;результате.</p>
    </div>

    <div class="grid-layout">
      <article class="feature-card">
        <span class="feature-card__title">Гибкое решение</span>
        <p class="card-description">Подбираем ленту под&nbsp;ваши задачи и&nbsp;бюджет.</p>
      </article>
      <article class="feature-card">
        <span class="feature-card__title">Сроки и&nbsp;качество</span>
        <p class="card-description">Соблюдаем сроки и&nbsp;гарантируем стабильное качество.</p>
      </article>
      <article class="feature-card">
        <span class="feature-card__title">Опыт и&nbsp;надёжность</span>
        <p class="card-description">Работаем с&nbsp;2010&nbsp;года. Нам доверяют по&nbsp;всей России.</p>
      </article>
      <article class="feature-card">
        <span class="feature-card__title">Поддержка клиентов</span>
        <p class="card-description">Всегда на&nbsp;связи и&nbsp;готовы помочь на&nbsp;каждом этапе.</p>
      </article>
      <article class="feature-card">
        <span class="feature-card__title">Быстрая отгрузка</span>
        <p class="card-description">Ходовые позиции отправляем со&nbsp;склада в&nbsp;короткие сроки.</p>
      </article>
      <article class="feature-card">
        <span class="feature-card__title">Честные параметры</span>
        <p class="card-description">Намотка, клейкость и&nbsp;ширина соответствуют заявке.</p>
      </article>
    </div>
  </div>
</section>
