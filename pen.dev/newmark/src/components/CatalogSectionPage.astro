---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "./Breadcrumbs.astro";
import CategoryLinkList from "./CategoryLinkList.astro";
import ProductItemCard from "./ProductItemCard.astro";

const { breadcrumbs, section } = Astro.props;
---

<BaseLayout title={section.seo?.title ?? `${section.title} Newmark`} description={section.seo?.description ?? section.description}>
  <Breadcrumbs items={breadcrumbs} />

  <section class="section">
    <div class="container">
      <div class="section-header section-header--page">
        <h1 class="section-title">{section.title}</h1>
        <p class="section-description">{section.description}</p>
      </div>

      <CategoryLinkList items={section.subsections} />

      {section.products.length > 0 ? (
        <div class="product-list" aria-label="Товары раздела">
          {section.products.map((product) => (
            <ProductItemCard product={product} />
          ))}
        </div>
      ) : (
        <p class="product-list-empty">Извините, в данном разделе пока нет товаров.</p>
      )}
    </div>
  </section>
</BaseLayout>
