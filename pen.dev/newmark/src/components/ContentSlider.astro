---
const { images = [] } = Astro.props;
---

{images.length > 0 && (
  <div class="content-slider swiper" data-content-slider>
    <div class="content-slider__wrapper swiper-wrapper">
      {images.map((image) => (
        <figure class="content-slider__slide swiper-slide">
          <img
            class="content-slider__image"
            src={image.src}
            alt={image.alt}
            width="400"
            height="300"
            loading="lazy"
          />
          {image.caption && <figcaption class="content-slider__caption">{image.caption}</figcaption>}
        </figure>
      ))}
    </div>
  </div>
)}
