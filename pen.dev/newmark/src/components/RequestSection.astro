<section class="section cta" id="request">
  <div class="container">
    <div class="cta__inner">
      <div class="cta__content">
        <div class="cta__text">
          <span class="cta__eyebrow">Давайте работать вместе</span>
          <span class="cta__title">Готовы оформить заказ?</span>
          <p class="cta__description">Свяжитесь с&nbsp;нами для&nbsp;консультации и&nbsp;подбора ленты под&nbsp;вашу задачу</p>
        </div>
        <div class="countdown cta__countdown" data-countdown-schedule="workweek-msk">
          <span class="countdown__title">Успейте отправить заявку и&nbsp;получить выгодное предложение</span>
          <div class="countdown__row">
            <div class="countdown__item" data-countdown-unit="days">
              <span class="countdown__value" data-countdown-value>02</span>
              <span class="countdown__label" data-countdown-label>дня</span>
            </div>
            <div class="countdown__item" data-countdown-unit="hours">
              <span class="countdown__value" data-countdown-value>14</span>
              <span class="countdown__label" data-countdown-label>часов</span>
            </div>
            <div class="countdown__item" data-countdown-unit="minutes">
              <span class="countdown__value" data-countdown-value>36</span>
              <span class="countdown__label" data-countdown-label>минут</span>
            </div>
            <div class="countdown__item" data-countdown-unit="seconds">
              <span class="countdown__value" data-countdown-value>08</span>
              <span class="countdown__label" data-countdown-label>секунд</span>
            </div>
          </div>
        </div>
      </div>

      <form class="request-form" action="/api/send-request" method="post" novalidate data-request-form>
        <input type="hidden" name="formType" value="request" />

        <div class="form-row">
          <label class="field">
            <span class="field__label">Ваше имя</span>
            <input class="field__control" type="text" name="name" placeholder="Иван" required />
          </label>
          <label class="field">
            <span class="field__label">Название компании</span>
            <input class="field__control" type="text" name="company" placeholder="Ооо компания" />
          </label>
        </div>

        <div class="form-row">
          <label class="field">
            <span class="field__label">Email</span>
            <input class="field__control" type="email" name="email" placeholder="mail@example.ru" />
          </label>
          <label class="field">
            <span class="field__label">Телефон</span>
            <input class="field__control" type="tel" name="phone" placeholder="+7 (900) 000 - 00 - 00" data-phone-mask required />
          </label>
        </div>

        <label class="field">
          <span class="field__label">Комментарий к&nbsp;заявке</span>
          <textarea class="field__control field__control--textarea" name="comment" placeholder="Опишите тип ленты, объём, город доставки или&nbsp;задачу упаковки"></textarea>
        </label>

        <div class="request-form__actions">
          <label class="file-button">
            <input class="file-button__input" type="file" name="attachment" accept=".pdf,.jpeg,.jpg,.png" multiple />
            <span class="file-button__label" data-file-button-label>Прикрепить Файлы(pdf,jpeg,jpg,png)</span>
          </label>
          <label class="consent-field">
            <input class="consent-field__input" type="checkbox" name="agreement" required />
            <span class="consent-field__text">Согласен на&nbsp;обработку персональных данных</span>
          </label>
          <button class="button button--primary" type="submit">Отправить заявку</button>
        </div>
      </form>
    </div>
  </div>
</section>
