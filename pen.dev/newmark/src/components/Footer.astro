---
import logoImage from "../images/webp/logo.webp";
---

<footer class="footer">
  <div class="container">
    <div class="footer__top">
      <a class="logo logo--footer" href="/" aria-label="НьюМарк">
        <img class="logo__image" src={logoImage.src} alt="НьюМарк" width="160" height="60" />
      </a>

      <div class="footer__column">
        <ul class="link-list">
          <li class="link-list__item"><a class="link-list__link" href="/catalog/">Каталог</a></li>
          <li class="link-list__item"><a class="link-list__link" href="/about/">О&nbsp;компании</a></li>
          <li class="link-list__item"><a class="link-list__link" href="/delivery/">Оплата и&nbsp;доставка</a></li>
          <li class="link-list__item"><a class="link-list__link" href="/contacts/">Контакты</a></li>
        </ul>
      </div>

      <div class="footer__column">
        <ul class="link-list">
          <li class="link-list__item"><a class="link-list__link" href="#">Самовывоз со&nbsp;склада</a></li>
          <li class="link-list__item"><a class="link-list__link" href="#">Доставка по&nbsp;городу</a></li>
          <li class="link-list__item"><a class="link-list__link" href="#">Транспортные компании</a></li>
        </ul>
      </div>

      <div class="footer__column">
        <ul class="link-list">
          <li class="link-list__item"><a class="link-list__link link-list__link--accent" href="tel:+70000000000">+7 (000) 000-00-00</a></li>
          <li class="link-list__item"><a class="link-list__link link-list__link--accent" href="mailto:sales@lenta.pro">sales@lenta.pro</a></li>
          <li class="link-list__item"><span class="link-list__text">Пн–Пт 9:00–18:00</span></li>
        </ul>
        <ul class="social-list">
          <li class="social-list__item">
            <a class="social-list__link" href="#" aria-label="Telegram">
              <svg class="social-list__icon" width="24" height="24" viewBox="0 0 14 12" aria-hidden="true">
                <use href="/sprite.svg#icon-tg"></use>
              </svg>
            </a>
          </li>
          <li class="social-list__item">
            <a class="social-list__link" href="#" aria-label="ВКонтакте">
              <svg class="social-list__icon social-list__icon--vk" width="28" height="28" viewBox="0 0 14 8" aria-hidden="true">
                <use href="/sprite.svg#icon-vk"></use>
              </svg>
            </a>
          </li>
          <li class="social-list__item">
            <a class="social-list__link" href="#" aria-label="Max">
              <svg class="social-list__icon" width="24" height="24" viewBox="0 0 15 14" aria-hidden="true">
                <use href="/sprite.svg#icon-max"></use>
              </svg>
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="footer__bottom">
      <span class="footer__copyright">© 2026, НьюМарк&nbsp;—&nbsp;каталог клейких лент, стрейч-плёнки и&nbsp;упаковочных аксессуаров</span>
      <div class="footer__legal">
        <a class="footer__legal-link" href="#">Реквизиты</a>
        <a class="footer__legal-link" href="#">Политика конфиденциальности</a>
        <a class="footer__legal-link" href="#">Условия продажи</a>
      </div>
    </div>
  </div>
</footer>
