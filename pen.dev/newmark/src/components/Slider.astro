---
import { Image } from "astro:assets";

const { images = [] } = Astro.props;
---

{images.length > 0 && (
  <div class="slider swiper" data-slider>
    <div class="slider__wrapper swiper-wrapper">
      {images.map((image) => (
        <figure class="slider__slide swiper-slide">
          <Image
            class="slider__image"
            src={image.src}
            alt={image.alt}
            width={image.width ?? 400}
            height={image.height ?? 300}
            loading={image.loading ?? "lazy"}
            fetchpriority={image.fetchpriority ?? "auto"}
          />
          {image.caption && <figcaption class="slider__caption">{image.caption}</figcaption>}
        </figure>
      ))}
    </div>
  </div>
)}
