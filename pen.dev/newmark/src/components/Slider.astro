---
const { images = [] } = Astro.props;
---

{images.length > 0 && (
  <div class="slider swiper" data-slider>
    <div class="slider__wrapper swiper-wrapper">
      {images.map((image) => (
        <figure class="slider__slide swiper-slide">
          <img
            class="slider__image"
            src={image.src}
            alt={image.alt}
            width="400"
            height="300"
            loading="lazy"
          />
          {image.caption && <figcaption class="slider__caption">{image.caption}</figcaption>}
        </figure>
      ))}
    </div>
  </div>
)}
