---
import { Image } from "astro:assets";
import stretchFilmImage from "../images/webp/product-image-3.webp";
import adhesiveTapeImage from "../images/webp/product-image-1.webp";
import signalTapeImage from "../images/webp/product-image-10.webp";

const { title = "Что мы предлагаем", titleTag = "h2" } = Astro.props;
const TitleTag = titleTag;
const headerClass = titleTag === "h1" ? "section-header section-header--page" : "section-header";
const imageLoading = titleTag === "h1" ? "eager" : "lazy";

const catalogItems = [
  {
    title: "Стрейч-пленка",
    description: "Плотно фиксирует товар на паллетах и защищает груз при хранении и перевозке.",
    href: "/catalog/stretch-plenka/",
    image: stretchFilmImage,
  },
  {
    title: "Клейкая лента",
    description: "Подберем ленту для упаковки, брендирования, ремонта, маркировки и специальных задач.",
    href: "/catalog/kleikaya-lenta/",
    image: adhesiveTapeImage,
  },
  {
    title: "Спец. ленты",
    description: "Помогают быстро ограждать зоны, выделять опасные участки и организовывать пространство.",
    href: "/catalog/spets-lenty/",
    image: signalTapeImage,
  },
];
---

<section class="section">
  <div class="container">
    <div class={headerClass}>
      <TitleTag class="section-title">{title}</TitleTag>
      <p class="section-description">Три направления каталога закрывают основные задачи упаковки, фиксации, маркировки и организации рабочих зон.</p>
    </div>

    <div class="grid-layout">
      {catalogItems.map((item, index) => (
        <article class="product-card">
          <div class="product-card__image-wrapper">
            <Image
              class="product-card__image"
              src={item.image}
              alt={item.title}
              width={400}
              height={300}
              loading={imageLoading}
              fetchpriority={titleTag === "h1" && index === 0 ? "high" : "auto"}
            />
          </div>
          <div class="product-card__body">
            <div class="product-card__content">
              <span class="product-card__title">{item.title}</span>
              <p class="card-description">{item.description}</p>
            </div>
            <a class="button button--primary" href={item.href}>Подробнее
              <svg class="button__icon button__icon--arrow" width="72" height="19" viewBox="0 0 72 19" aria-hidden="true">
                <use href="/sprite.svg?v=2#long-arrow"></use>
              </svg>
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="section section--dark advantages">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">Преимущества, которые работают</h2>
      <p class="section-description">Для&nbsp;нас важна каждая деталь в&nbsp;производстве лент, а&nbsp;для&nbsp;вас&nbsp;—&nbsp;точность и&nbsp;уверенность в&nbsp;результате.</p>
    </div>

    <div class="grid-layout">
      <article class="feature-card">
        <span class="feature-card__title">Гибкое решение</span>
        <p class="card-description">Подбираем ленту под&nbsp;ваши задачи и&nbsp;бюджет.</p>
      </article>
      <article class="feature-card">
        <span class="feature-card__title">Сроки и&nbsp;качество</span>
        <p class="card-description">Соблюдаем сроки и&nbsp;гарантируем стабильное качество.</p>
      </article>
      <article class="feature-card">
        <span class="feature-card__title">Опыт и&nbsp;надёжность</span>
        <p class="card-description">Работаем с&nbsp;2010&nbsp;года. Нам доверяют по&nbsp;всей России.</p>
      </article>
      <article class="feature-card">
        <span class="feature-card__title">Поддержка клиентов</span>
        <p class="card-description">Всегда на&nbsp;связи и&nbsp;готовы помочь на&nbsp;каждом этапе.</p>
      </article>
      <article class="feature-card">
        <span class="feature-card__title">Быстрая отгрузка</span>
        <p class="card-description">Ходовые позиции отправляем со&nbsp;склада в&nbsp;короткие сроки.</p>
      </article>
      <article class="feature-card">
        <span class="feature-card__title">Честные параметры</span>
        <p class="card-description">Намотка, клейкость и&nbsp;ширина соответствуют заявке.</p>
      </article>
    </div>
  </div>
</section>
