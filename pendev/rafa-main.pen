{
  "id": "rafa-main",
  "type": "frame",
  "name": "Рафа — Главная",
  "width": 1280,
  "height": 900,
  "fills": [{ "type": "solid", "color": "#f0eee6" }],
  "children": [
    {
      "id": "navbar",
      "type": "frame",
      "name": "Навигация",
      "x": 0,
      "y": 0,
      "width": 1280,
      "height": 72,
      "layout": "flex",
      "justifyContent": "space-between",
      "alignItems": "center",
      "padding": { "left": 24, "right": 24 },
      "children": [
        {
          "id": "logo",
          "type": "rectangle",
          "name": "Логотип",
          "width": 120,
          "height": 32,
          "fills": [{ "type": "solid", "color": "#141413" }],
          "cornerRadius": 4
        },
        {
          "id": "nav-links",
          "type": "frame",
          "name": "Ссылки",
          "layout": "flex",
          "gap": 8,
          "children": [
            { "id": "nav-catalog", "type": "text", "content": "Каталог", "fontSize": 12, "fontFamily": "Golos Text", "color": "#141413" },
            { "id": "nav-about", "type": "text", "content": "О компании", "fontSize": 12, "fontFamily": "Golos Text", "color": "#141413" },
            { "id": "nav-contacts", "type": "text", "content": "Контакты", "fontSize": 12, "fontFamily": "Golos Text", "color": "#141413" }
          ]
        }
      ]
    },
    {
      "id": "hero-section",
      "type": "frame",
      "name": "Hero",
      "x": 0,
      "y": 120,
      "width": 1280,
      "height": 360,
      "layout": "flex",
      "gap": 76,
      "padding": { "left": 24, "right": 24 },
      "children": [
        {
          "id": "hero-heading",
          "type": "frame",
          "name": "Заголовок слева",
          "width": 500,
          "children": [
            {
              "id": "hero-title",
              "type": "text",
              "content": "Клейкая лента\nс логотипом от\nпроизводителя",
              "fontSize": 61,
              "fontFamily": "Golos Text",
              "fontWeight": 700,
              "lineHeight": 1.1,
              "letterSpacing": -0.12,
              "color": "#141413"
            }
          ]
        },
        {
          "id": "hero-support",
          "type": "frame",
          "name": "Текст справа",
          "width": 500,
          "children": [
            {
              "id": "hero-text",
              "type": "text",
              "content": "Собственное производство с 2003 года. Бесплатно разработаем макет, изготовим клише и предоставим образцы для тестирования.",
              "fontSize": 20,
              "fontFamily": "PT Serif",
              "lineHeight": 1.4,
              "color": "#141413"
            },
            {
              "id": "hero-btn",
              "type": "rectangle",
              "name": "Кнопка",
              "y": 80,
              "width": 220,
              "height": 46,
              "fills": [{ "type": "solid", "color": "#d97757" }],
              "cornerRadius": 8,
              "children": [
                {
                  "id": "hero-btn-text",
                  "type": "text",
                  "content": "Рассчитать стоимость →",
                  "fontSize": 16,
                  "fontFamily": "Golos Text",
                  "fontWeight": 600,
                  "color": "#141413",
                  "x": 20,
                  "y": 12
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "cards-section",
      "type": "frame",
      "name": "Карточки категорий",
      "x": 24,
      "y": 520,
      "width": 1232,
      "height": 260,
      "layout": "flex",
      "gap": 24,
      "children": [
        {
          "id": "card-1",
          "type": "rectangle",
          "name": "Карточка: Стреппинг",
          "width": 380,
          "height": 260,
          "fills": [{ "type": "solid", "color": "#faf9f5" }],
          "cornerRadius": 24,
          "children": [
            {
              "id": "card-1-label",
              "type": "text",
              "content": "КАТЕГОРИЯ",
              "fontSize": 12,
              "fontFamily": "Golos Text",
              "fontWeight": 600,
              "color": "#b0aea5",
              "x": 24,
              "y": 24
            },
            {
              "id": "card-1-title",
              "type": "text",
              "content": "Стреппинг-ленты",
              "fontSize": 24,
              "fontFamily": "Golos Text",
              "fontWeight": 600,
              "color": "#141413",
              "x": 24,
              "y": 52
            },
            {
              "id": "card-1-desc",
              "type": "text",
              "content": "Полипропиленовая лента\n5–19 мм для ручной и\nмашинной упаковки.",
              "fontSize": 20,
              "fontFamily": "PT Serif",
              "lineHeight": 1.4,
              "color": "#141413",
              "x": 24,
              "y": 90
            }
          ]
        },
        {
          "id": "card-2",
          "type": "rectangle",
          "name": "Карточка: Клейкая лента",
          "width": 380,
          "height": 260,
          "fills": [{ "type": "solid", "color": "#faf9f5" }],
          "cornerRadius": 24,
          "children": [
            {
              "id": "card-2-label",
              "type": "text",
              "content": "КАТЕГОРИЯ",
              "fontSize": 12,
              "fontFamily": "Golos Text",
              "fontWeight": 600,
              "color": "#b0aea5",
              "x": 24,
              "y": 24
            },
            {
              "id": "card-2-title",
              "type": "text",
              "content": "Клейкая лента",
              "fontSize": 24,
              "fontFamily": "Golos Text",
              "fontWeight": 600,
              "color": "#141413",
              "x": 24,
              "y": 52
            },
            {
              "id": "card-2-desc",
              "type": "text",
              "content": "Нова Ролл. С логотипом.\nСпециальные надписи.\nОт 45 мкм.",
              "fontSize": 20,
              "fontFamily": "PT Serif",
              "lineHeight": 1.4,
              "color": "#141413",
              "x": 24,
              "y": 90
            }
          ]
        },
        {
          "id": "card-3",
          "type": "rectangle",
          "name": "Карточка: ПЭТ (избранное)",
          "width": 380,
          "height": 260,
          "fills": [{ "type": "solid", "color": "#f5e3c7" }],
          "cornerRadius": 24,
          "children": [
            {
              "id": "card-3-label",
              "type": "text",
              "content": "НОВИНКА",
              "fontSize": 12,
              "fontFamily": "Golos Text",
              "fontWeight": 600,
              "color": "#b0aea5",
              "x": 24,
              "y": 24
            },
            {
              "id": "card-3-title",
              "type": "text",
              "content": "ПЭТ-лента",
              "fontSize": 24,
              "fontFamily": "Golos Text",
              "fontWeight": 600,
              "color": "#141413",
              "x": 24,
              "y": 52
            },
            {
              "id": "card-3-desc",
              "type": "text",
              "content": "Полиэстеровая —\nпо прочности близка\nк стальной.",
              "fontSize": 20,
              "fontFamily": "PT Serif",
              "lineHeight": 1.4,
              "color": "#141413",
              "x": 24,
              "y": 90
            }
          ]
        }
      ]
    },
    {
      "id": "footer-section",
      "type": "frame",
      "name": "Футер",
      "x": 0,
      "y": 820,
      "width": 1280,
      "height": 80,
      "fills": [{ "type": "solid", "color": "#141413" }]
    }
  ]
}